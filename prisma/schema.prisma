// Prisma schema for fast-expense-tracker.
//
// DATABASE_URL           — pooled (PgBouncer) endpoint, used at runtime by the
//                          Next.js app via the Prisma client singleton in `lib/db.ts`.
// DATABASE_URL_UNPOOLED  — direct (non-pooled) endpoint, used by Prisma migrations
//                          because PgBouncer interferes with prepared statements.
//                          Name matches what the Neon–Vercel integration injects
//                          (prod + per-PR preview branches), so migrations work on
//                          every environment without remapping.
//
// Field names mirror MoneyFlow's schema 1:1 so the eventual migration is
// `pg_dump | pg_restore` + one translation script (spec §3). Monetary fields are
// `Float` for that parity — the rounding trade-off is accepted in the spec.
// Forward-compat fields land here even when their UI ships later (schema-forward
// principle — spec §5). Source of truth: docs/reference/domain-reference.md §2 +
// docs/specs/0001-initial-design.md §3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt hash — never plaintext
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses        Expense[]
  cards           Card[]
  settings        Settings?
  movements       Movement[]
  incomes         Income[]
  categories      Category[]
  subcategories   Subcategory[]
  categoryBudgets CategoryBudget[]
}

// Per-user category (ADR-0022). Each account owns its own copy of the category
// set — seeded from the shared starter kit. `slug` is unique **per user**
// (`@@unique([userId, slug])`), not globally, so every user may have a `housing`.
model Category {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  slug             String
  name             String
  color            String   @default("#6b7280") // per-category hex; user-editable. See domain-reference.md §1
  isRelevant       Boolean  @default(true)
  isSystemCategory Boolean  @default(true) // starter-kit default for this user
  monthlyBudget    Float? // null = no budget set
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subcategories Subcategory[]
  expenses      Expense[]
  budgets       CategoryBudget[]

  @@unique([userId, slug])
}

// Per-month budget override for a category (ADR-0016), now per-user (ADR-0022).
// `Category.monthlyBudget` is the DEFAULT applied to any month without a row
// here; a row here supersedes it for its `month`. The override key is
// `@@unique([userId, categoryId, month])` so each user owns their own overrides.
model CategoryBudget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  month      String // "YYYY-MM" — the month this override applies to (CDMX frame)
  amount     Float // MXN limit for that month
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month])
}

// Per-user subcategory (ADR-0022) — belongs to a per-user Category and carries
// its own `userId` so every read/write can scope by the signed-in user.
model Subcategory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  expenses Expense[]
}

model Card {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  color      String // card color coding — see domain-reference.md §4
  type       String // "credit" | "debit" | "cash"
  // Soft-archive (spec 0006 §6): an archived card drops out of pickers but stays
  // attached to its history, so past months/totals never break. Null = active.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  expenses  Expense[]
  movements Movement[]
}

model Expense {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])

  cardId String? // null = cash
  // RESTRICT (spec 0006 §6): a card with expenses can't be hard-deleted — the DB
  // backs up the action's reference re-check so history never silently loses its
  // card label (Prisma's default for an optional relation is SetNull, which would
  // do exactly that). Referenced cards are archived, not deleted.
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  date        DateTime
  description String
  amount      Float // MXN out of pocket (canonical budgeting truth)

  // Shared expense math
  isShared          Boolean @default(false)
  yourPercentage    Float   @default(1.0) // 1.0 = 100% mine; 0.68 = my 68% share
  actualExpenditure Float // stored, not computed: isShared ? amount * yourPercentage : amount
  // DEPRECATED (ADR-0020): always "you". Column retained until a later chore
  // drops it; all reads treat expenses as the user's own.
  paidBy            String  @default("you")

  // Which month's money funded this purchase (spec 0007 §3.1):
  // income | savings | reimbursed. Only "income" counts toward the 50/25/25
  // budget — savings was already counted in the month it was set aside, and a
  // reimbursed purchase was paid back by a third party. A String (not a DB
  // enum) to match `Movement.type` and `paidBy`; the Zod enum is the guard.
  // The card never reads this: a card payment stays source-agnostic (ADR-0020
  // §6), so spend-by-card still sees the full amount.
  fundedFrom        String  @default("income")

  // Money you SENT the partner (spec 0007 §6b). Paying her is the moment the
  // money is really spent, so this is an expense like any other: it carries a
  // category and counts in the buckets. A debt she fronted is NOT — it is
  // provisional, and stays a Movement{type:"gf_fronted"} until a payment settles
  // it, because something she owes you can cancel it before any money moves.
  //
  // `amount` is what you sent, so `isShared` is false and `actualExpenditure`
  // equals `amount`. One read excludes it: spend-by-card, because a payment
  // usually has no card, and a cardless row read as "Cash" is BUG-1's symptom.
  // The settlement layer reads this flag as the "you paid her" side of the
  // balance — the side that draws the balance DOWN, the opposite sign to what
  // you owe her.
  isPartnerPayment  Boolean @default(false)

  // Forward-compat fields (UI ships in later phases — spec §3)
  isRecurring      Boolean @default(false) // Phase 3
  originalAmount   Float? // Phase 5 (multi-currency reference)
  originalCurrency String? // Phase 5

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model Settings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  monthlyIncome             Float   @default(0)
  // Opt-in shared-expense mode (spec 0006 / ADR-0021). Default solo: a plain
  // tracker with no split control, no settlement, no partner. When true the app
  // reveals the shared machinery and `partnerName` is required in the UI.
  sharesExpenses            Boolean @default(false)
  // The partner's display name — per-user data, replacing the hardcoded
  // `PARTNER_NAME` constant. Null in solo mode; required in the UI when
  // `sharesExpenses` is on. Only meaningful in shared mode.
  partnerName               String?
  defaultSharePercentage    Float   @default(0.68) // only meaningful when sharesExpenses
  emailDay                  Int     @default(1) // 0=Sun, 1=Mon, ..., 6=Sat
  recurringPromptSuppressed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum IncomeType {
  FIXED // recurring monthly salary — one row per user, no date
  VARIABLE // one-off income logged against a specific month (date set)
}

// Income sources (slice 2.3) — the real data behind the 50/25/25 budget targets,
// superseding the `Settings.monthlyIncome` stopgap. A FIXED row is the recurring
// monthly amount (date null); VARIABLE rows are dated and month-scoped via the
// same CDMX 06:00Z frame as Expense, so `getMonthRangeUtc` queries them directly.
model Income {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   IncomeType
  amount Float // always positive (MXN)
  source String? // VARIABLE label (e.g. "Freelance — logo"); null for FIXED
  date   DateTime? // VARIABLE only; null for FIXED (recurs every month)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Actual money movements (spec 0003): settlement transfers with gf, card
// payments, one-off income. Decoupled from what's "owed" — amounts are
// user-entered, never auto-derived, and never enter expense/spend totals.
model Movement {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date   DateTime
  amount Float // always positive; direction comes from `type`
  // gf_received | gf_paid | card_payment | gf_fronted | income | other.
  //
  // `gf_fronted` is a debt the partner fronted. It is settlement-only and is
  // NOT an expense (spec 0007 §6b): it is provisional, because something she
  // owes you can shrink or cancel it before any money moves.
  //
  // `gf_paid` is LEGACY. Money you send her is an `Expense{isPartnerPayment}`
  // now — that transfer is the moment real money leaves — so nothing writes
  // this type anymore. NO migration converts the existing rows: the conversion
  // is data, and data is deferred to its own PR. Until it runs, every read that
  // counts payments must count these too (settlement's balance and the feed
  // footer both do), or the money silently disappears from a screen.
  type   String

  cardId String? // set when type = "card_payment"
  // RESTRICT — same as Expense.card: a referenced card is archived, never
  // hard-deleted, so a card payment never silently loses its card (spec 0006 §6).
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  note String?

  // Which month's money funded a transfer to the partner (spec 0007 §3.1):
  // income | savings. Meaningful for `gf_paid` only — the one movement type
  // that is an outflow of the user's own money. A card payment stays
  // source-agnostic (§3.2, ADR-0020 §6) and a `gf_fronted` debt moved no cash,
  // so both keep the "income" default and no read consults this for them.
  // `reimbursed` is deliberately absent: it is Health-only (§3.3) and a
  // transfer has no category. A String, not a DB enum, to match `type`.
  fundedFrom String @default("income")

  // Settlement-cycle marker (spec 0007 §3.5). Non-null says both "this transfer
  // closed a cycle" AND "the cycle ended at this instant" — one column, so the
  // fact and the boundary can never disagree. There is no cycle table: cycles
  // are DERIVED from the sequence of markers (spec 0005 §2: store atomic facts,
  // derive every view). The boundary is the CLOSE instant, not the transfer's
  // own `createdAt`, so a row entered between that transfer and the user's
  // confirmation is filed under the cycle whose balance already counted it.
  // Valid only on gf_paid/gf_received; a CHECK in the migration enforces that
  // on insert AND update.
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  // Serves the marker scan that derives the cycle boundaries.
  @@index([userId, closedAt])
}
